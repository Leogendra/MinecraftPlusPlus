{
	"schemaVersion": 1,
	"id": "minecraftpp",
	"version": "${version}",
	"name": "Minecraft++",
	"description": "Replaces the vanilla ores with seven procedurally generated ores, each with its own name, color, rarity, roles, tools and armor.",
	"authors": [
		"Leogendra"
	],
	"license": "Apache-2.0",
	"icon": "assets/minecraftpp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.minecraftpp.MinecraftPlusPlus"
		],
		"client": [
			"fr.minecraftpp.client.MinecraftPlusPlusClient"
		]
	},
	"mixins": [
		"minecraftpp.mixins.json",
		{
			"config": "minecraftpp.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
